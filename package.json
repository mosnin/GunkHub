{
  "name": "agent-flight-recorder",
  "private": true,
  "version": "0.0.1",
  "description": "Agent execution debugging and replay platform",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
