# =============================================================================
# Agent Flight Recorder — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or any file with real secrets.
# This file IS committed — it is the authoritative list of required env vars.
# =============================================================================

# -----------------------------------------------------------------------------
# Clerk Authentication
# https://dashboard.clerk.com → your app → API Keys
#
# Clerk handles all authentication and organization management.
# Create an application at https://clerk.com to obtain these keys.
# Organizations in Clerk map 1:1 to Organization records in Convex.
# -----------------------------------------------------------------------------

# The publishable key is safe to expose in the browser bundle.
# It identifies your Clerk application to the Clerk JS SDK.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# The secret key must NEVER be exposed to the browser.
# Used by Next.js API routes and server components to verify sessions and
# fetch organization membership from the Clerk backend API.
CLERK_SECRET_KEY=sk_test_replace_me

# REQUIRED SETUP: Clerk JWT Template for Convex
# In Clerk Dashboard → JWT Templates → New Template → select "Convex".
# Name it exactly "convex". This creates the token used by the server-side
# service layer to authenticate Convex queries and mutations via:
#   const token = await getToken({ template: 'convex' })
# Without this template the service layer cannot call Convex on behalf of users.

# The Clerk webhook signing secret used to verify incoming webhook events.
# In Clerk Dashboard → Webhooks → your endpoint → Signing Secret.
# Create a webhook endpoint pointing to https://<your-domain>/api/webhooks/clerk
# and subscribe to: organization.created, organization.updated,
# organizationMembership.created
# This secret is required for the org bootstrap flow to work.
CLERK_WEBHOOK_SECRET=whsec_replace_me

# Shared secret that authorizes the Clerk webhook route to call the webhook-only
# Convex lifecycle mutations (upsertOrganization / createOrganization /
# upsertMembership). These are on the public Convex function surface, so they
# require this secret to reject forged calls that would otherwise let anyone mint
# an admin membership in any org. Set the SAME value here (read by the Next.js
# webhook route) and on the Convex deployment as CONVEX_WEBHOOK_SECRET
# (`npx convex env set CONVEX_WEBHOOK_SECRET <value>`). Generate with:
#   openssl rand -hex 32
# See ADR-0023 for the internalMutation + httpAction migration that supersedes this.
#
# ROTATION FORMAT: this value MAY be a comma-separated pair "current,previous"
# (e.g. "newsecret,oldsecret") during a rotation window. The webhook route
# forwards the FIRST value to Convex, and retries once with the SECOND value
# if Convex rejects it as unauthorized — so Vercel and Convex can be updated
# in either order without calls failing closed. Convex itself only ever holds
# ONE plain value. See docs/operations_runbook.md → "Secret rotation" for the
# full procedure. Outside a rotation window, set a single value (no comma).
CONVEX_WEBHOOK_SECRET=replace_me_with_openssl_rand_hex_32

# The Clerk JWT issuer domain used by Convex to verify JWTs.
# In Clerk Dashboard → API Keys → Advanced → JWT Issuer Domain.
# Format: https://<clerk-frontend-api-domain>
# Example: https://your-app.clerk.accounts.dev
# This value is used in convex/auth.config.ts to trust Clerk-issued JWTs.
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev

# -----------------------------------------------------------------------------
# Convex Backend
# https://dashboard.convex.dev → your deployment → Settings
#
# Convex provides the database, serverless functions, and real-time
# subscriptions for Agent Flight Recorder.
# Run `npx convex dev` to create a local dev deployment.
# -----------------------------------------------------------------------------

# The URL of your Convex deployment. Safe to expose to the browser.
# Format: https://<deployment-name>.convex.cloud
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# The deploy key used by the Convex CLI to push schema and functions in CI/CD.
# Required for `convex deploy` in non-interactive environments.
# Not needed for local dev — `convex dev` handles auth interactively.
# Treat this like a password; never commit it or log it.
CONVEX_DEPLOY_KEY=prod:your-deploy-key-here

# -----------------------------------------------------------------------------
# Blob Storage (for large event payloads > 10KB)
#
# The event log stores event payloads inline for small records (<10KB).
# For payloads that exceed the size threshold, the raw bytes are written to
# blob storage and the Convex artifact record stores only a pointer (URL +
# checksum). This keeps the Convex document store lean and fast.
#
# Compatible with Vercel Blob, AWS S3, Cloudflare R2, or any S3-style API.
# For local dev you may leave these unset; the SDK will store small payloads
# inline. Large payload externalisation requires a real blob store.
# -----------------------------------------------------------------------------

# The base URL of your blob storage bucket.
# Example (Vercel Blob): https://your-store.public.blob.vercel-storage.com
# Example (AWS S3):      https://s3.us-east-1.amazonaws.com/your-bucket
BLOB_STORE_URL=https://your-bucket.blob.vercel-storage.com

# The read-write token for authenticating blob store operations.
# For Vercel Blob: found in Storage → your store → .env.local tab.
# For S3-compatible stores: use your access key / bearer token.
BLOB_STORE_TOKEN=vercel_blob_rw_replace_me

# -----------------------------------------------------------------------------
# SDK (client recording library)
#
# The recording SDK (@agent-flight-recorder/sdk) authenticates to the ingestion
# API with a per-project API key. This is the key an SDK consumer copies from the
# in-app setup snippets (project detail / agent detail pages) and sets in their
# OWN agent's environment. It is NOT consumed by the web app or Convex at boot —
# no startup validation is wired for it here; it is documented so operators know
# what the setup snippets refer to.
# -----------------------------------------------------------------------------

# The Agent Flight Recorder ingestion API key used by the SDK to ship events.
# Obtain it from the app: Project → Settings, or the setup snippet on an agent page.
AFR_API_KEY=afr_replace_me

# -----------------------------------------------------------------------------
# Integration Tests (optional — only required for running real Convex tests)
#
# These variables are NOT needed for local development or standard CI.
# They enable `tests/integration/api.test.ts` to run against a real Convex
# deployment instead of using fixture stubs.
#
# Set up:
#   1. Deploy the app to a test environment (e.g. `npx convex deploy --test`)
#   2. Provision a test API key via the settings page or the createApiKey mutation
#   3. Set CONVEX_TEST_URL to the base URL of the running test Next.js app
#   4. Set TEST_API_KEY to the raw key value (not the hash)
#   5. Set TEST_AGENT_ID to a valid agent Convex document ID in the test org
# -----------------------------------------------------------------------------

# Base URL of the test Next.js deployment.
# Example: http://localhost:3000 (local) or https://your-app-test.vercel.app (staging)
CONVEX_TEST_URL=

# A valid API key for the test Convex deployment's test org.
# Must be the raw key value (not the SHA-256 hash stored in Convex).
TEST_API_KEY=

# Convex document ID of a valid agent in the test org.
# Example: jd7abc123xyz...
TEST_AGENT_ID=

# -----------------------------------------------------------------------------
# Derivation Verification (optional — enables full replay/projection checks)
#
# When configured, the Convex scheduled action (verifyRecentRuns) calls the
# web app's internal route to verify buildReplayProjection and buildFailureSummary
# in addition to sequence integrity. Without it, only sequence integrity is checked.
#
# Setup:
#   1. Generate a strong secret:  openssl rand -hex 32
#   2. Set INTERNAL_VERIFY_SECRET in your web deployment environment (.env.local
#      for dev, environment variables UI for Vercel/production).
#   3. Set the same secret and your web base URL in Convex:
#        npx convex env set INTERNAL_VERIFY_SECRET your-secret-here
#        npx convex env set INTERNAL_VERIFY_URL https://yourapp.com
#      Note: INTERNAL_VERIFY_URL is a Convex env var — it is NOT set here.
#
# Graceful degradation: if these are unset or the web route is unreachable,
# verifyRecentRuns stores a sequence-only result (checksRan absent).
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Alert Email Delivery (optional — Cycle 3, completes the deferred alert-email
# path from docs/design/action_layer.md / ADR-002 / ADR-003)
#
# alert_rules with an "email" channel render a plain-text body
# (convex/helpers/notifier.ts renderAlertEmailText) and enqueue an
# email_deliveries row, drained every minute by convex/email_engine.ts.
#
# Unset (default): emails are logged via ConsoleEmailNotifier and marked
# "delivered" — no crash, no stuck "pending" rows, safe for local dev and any
# deployment that hasn't chosen a provider yet.
# -----------------------------------------------------------------------------

# Selects the real email provider. Leave unset for the console/log fallback.
# Currently supported: "resend". Any other/unrecognized value also falls back
# to the console notifier (with a warning), never a hard failure.
AFR_EMAIL_PROVIDER=

# Required only when AFR_EMAIL_PROVIDER=resend. Resend API key
# (https://resend.com/api-keys). If unset while AFR_EMAIL_PROVIDER=resend,
# delivery falls back to the console notifier rather than failing.
RESEND_API_KEY=

# Required only when AFR_EMAIL_PROVIDER=resend. The "from" address Resend
# sends alert emails as (must be a verified sender/domain in your Resend
# account).
AFR_EMAIL_FROM=alerts@your-domain.example

# Optional. Base URL used to build the "View run" link in alert emails
# (e.g. https://app.your-domain.example). Unset = the email links with a
# relative path only.
AFR_WEB_BASE_URL=

# Shared secret between the Convex action and the web internal verify route.
# Generate with: openssl rand -hex 32
#
# ROTATION FORMAT: this value MAY be a comma-separated list "current,previous"
# (e.g. "newsecret,oldsecret") during a rotation window. The verify-derivation
# route accepts the incoming x-internal-secret header if it matches ANY entry
# in the list — so it validates whichever single value Convex's
# verifyRecentRuns action currently has configured, old or new. Convex itself
# only ever holds ONE plain value. See docs/operations_runbook.md → "Secret
# rotation" for the full procedure. Outside a rotation window, set a single
# value (no comma).
INTERNAL_VERIFY_SECRET=replace_with_a_strong_random_secret

# -----------------------------------------------------------------------------
# Run Explanation LLM Provider ("Why did this fail?" — Explainability Layer,
# ADR-004. See docs/design/explanations.md and docs/adr/004-run-explanations.md
# for the full design and threat model.)
#
# OPTIONAL — the product works with ZERO config here. Every failed/timed_out/
# cancelled run's explanation gets a deterministic, heuristic root-cause
# analysis over the event log (Team B's buildHeuristicExplanation,
# convex/insights.ts) regardless of these variables. Setting them
# additionally asks a real LLM to produce a plain-English narrative grounded
# in the same trace — used ONLY if its response cites at least one real
# sequenceNumber from the run and provides a non-empty summary/root cause
# (convex/run_explanations.ts's grounding gate); otherwise the heuristic
# result already computed is kept. Nothing here is required for the "Why did
# this fail?" panel to work.
#
# Unset/anything other than "http" (default): convex/helpers/llm_provider.ts's
# `getConfiguredExplanationLLM()` returns `NoopExplanationLLM` — zero network
# calls, always reports "not configured" — the heuristic explanation ships
# alone.
#
# Deliberately vendor-agnostic: this is a generic HTTP-POST provider, not a
# hardcoded Anthropic/OpenAI/etc. client. Point it at any endpoint that
# accepts `{ prompt: string }` as JSON and responds with
# `{ summary, rootCause, suggestedFix?, citedSeqNums: number[] }` — e.g. a
# small proxy/Lambda in front of whichever vendor API you use.
# -----------------------------------------------------------------------------

# Selects the LLM provider. Leave unset for the zero-config heuristic-only
# default. Currently supported: "http" (generic HTTP-POST, see above). Any
# other/unrecognized value also falls back to the no-op provider (with a
# console warning), never a hard failure.
AFR_LLM_PROVIDER=

# Required only when AFR_LLM_PROVIDER=http. The full URL of your
# vendor-adapter endpoint (must accept POST with a JSON `{ prompt }` body per
# the contract above). If unset while AFR_LLM_PROVIDER=http, generation falls
# back to the no-op provider rather than failing the explanation action.
AFR_LLM_ENDPOINT=

# Optional. Sent as `Authorization: Bearer <value>` to AFR_LLM_ENDPOINT if
# set. Server-side only: never sent to the client, never logged, never
# echoed in any error response.
AFR_LLM_API_KEY=

# Optional. Free-form label recorded alongside an LLM-sourced explanation
# (the `model` field on the stored `run_explanations` row / the
# `RunExplanation.model` API field) — purely descriptive/attribution, not
# sent to AFR_LLM_ENDPOINT or used to select behavior.
AFR_LLM_MODEL=
