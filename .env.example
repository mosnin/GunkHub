# =============================================================================
# Agent Flight Recorder — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or any file with real secrets.
# This file IS committed — it is the authoritative list of required env vars.
# =============================================================================

# -----------------------------------------------------------------------------
# Clerk Authentication
# https://dashboard.clerk.com → your app → API Keys
#
# Clerk handles all authentication and organization management.
# Create an application at https://clerk.com to obtain these keys.
# Organizations in Clerk map 1:1 to Organization records in Convex.
# -----------------------------------------------------------------------------

# The publishable key is safe to expose in the browser bundle.
# It identifies your Clerk application to the Clerk JS SDK.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# The secret key must NEVER be exposed to the browser.
# Used by Next.js API routes and server components to verify sessions and
# fetch organization membership from the Clerk backend API.
CLERK_SECRET_KEY=sk_test_replace_me

# REQUIRED SETUP: Clerk JWT Template for Convex
# In Clerk Dashboard → JWT Templates → New Template → select "Convex".
# Name it exactly "convex". This creates the token used by the server-side
# service layer to authenticate Convex queries and mutations via:
#   const token = await getToken({ template: 'convex' })
# Without this template the service layer cannot call Convex on behalf of users.

# The Clerk webhook signing secret used to verify incoming webhook events.
# In Clerk Dashboard → Webhooks → your endpoint → Signing Secret.
# Create a webhook endpoint pointing to https://<your-domain>/api/webhooks/clerk
# and subscribe to: organization.created, organization.updated,
# organizationMembership.created
# This secret is required for the org bootstrap flow to work.
CLERK_WEBHOOK_SECRET=whsec_replace_me

# The Clerk JWT issuer domain used by Convex to verify JWTs.
# In Clerk Dashboard → API Keys → Advanced → JWT Issuer Domain.
# Format: https://<clerk-frontend-api-domain>
# Example: https://your-app.clerk.accounts.dev
# This value is used in convex/auth.config.ts to trust Clerk-issued JWTs.
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev

# -----------------------------------------------------------------------------
# Convex Backend
# https://dashboard.convex.dev → your deployment → Settings
#
# Convex provides the database, serverless functions, and real-time
# subscriptions for Agent Flight Recorder.
# Run `npx convex dev` to create a local dev deployment.
# -----------------------------------------------------------------------------

# The URL of your Convex deployment. Safe to expose to the browser.
# Format: https://<deployment-name>.convex.cloud
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# The deploy key used by the Convex CLI to push schema and functions in CI/CD.
# Required for `convex deploy` in non-interactive environments.
# Not needed for local dev — `convex dev` handles auth interactively.
# Treat this like a password; never commit it or log it.
CONVEX_DEPLOY_KEY=prod:your-deploy-key-here

# -----------------------------------------------------------------------------
# Blob Storage (for large event payloads > 10KB)
#
# The event log stores event payloads inline for small records (<10KB).
# For payloads that exceed the size threshold, the raw bytes are written to
# blob storage and the Convex artifact record stores only a pointer (URL +
# checksum). This keeps the Convex document store lean and fast.
#
# Compatible with Vercel Blob, AWS S3, Cloudflare R2, or any S3-style API.
# For local dev you may leave these unset; the SDK will store small payloads
# inline. Large payload externalisation requires a real blob store.
# -----------------------------------------------------------------------------

# The base URL of your blob storage bucket.
# Example (Vercel Blob): https://your-store.public.blob.vercel-storage.com
# Example (AWS S3):      https://s3.us-east-1.amazonaws.com/your-bucket
BLOB_STORE_URL=https://your-bucket.blob.vercel-storage.com

# The read-write token for authenticating blob store operations.
# For Vercel Blob: found in Storage → your store → .env.local tab.
# For S3-compatible stores: use your access key / bearer token.
BLOB_STORE_TOKEN=vercel_blob_rw_replace_me
