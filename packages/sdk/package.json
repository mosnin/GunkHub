{
  "name": "@afr/sdk",
  "version": "0.1.0",
  "description": "Agent Flight Recorder SDK — instrument agent code to record executions",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "echo 'sdk: source-only for v1 internal use'",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --noEmit --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@afr/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
